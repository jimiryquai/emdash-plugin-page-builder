---
import type { FeaturesSectionProps } from 'emdash-plugin-page-builder/blocks';

type Props = FeaturesSectionProps;

const { value, blockKey } = Astro.props;
const { heading, eyebrow, subheadline, items = [] } = value;
---
<section data-variant="three-column" data-key={blockKey} class="grid-cols-3">
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{heading}</h2>
  {subheadline && <p class="subheadline">{subheadline}</p>}
  <div class="three-column-grid">
    {items.map((item) => (
      <article data-title={item.title}>
        {item.icon && <span class="icon">{item.icon}</span>}
        <h3>{item.title}</h3>
        {item.description && <p>{item.description}</p>}
      </article>
    ))}
  </div>
</section>
