---
const { value, blockKey, index } = Astro.props;
const { columns = [], rows = [] } = value;
---
<section data-variant={value.variant ?? 'default'} data-key={blockKey} data-index={index}>
  {columns.map((column) => <span data-column={column.key}>{column.label}</span>)}
  {rows.map((row) => (
    <span
      data-row={row.name}
      data-group={row.group_name}
      data-values={[row.first_value, row.second_value, row.third_value].join('|')}
    >{row.name}</span>
  ))}
</section>
