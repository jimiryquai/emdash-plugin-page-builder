---
import { Blocks } from 'emdash/ui';
import type { BlockComponent } from 'emdash/ui';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import { createComponent } from 'astro/runtime/server/index.js';
import { COUNT_FIELD_SLUG, isSourceResult, mergeCacheHints, migrateBlocks, SCOPE_FIELD_SLUG, VARIANT_FIELD_SLUG } from 'emdash-plugin-page-builder/blocks';
import type { SiteBlockType, Source, StoredBlock } from 'emdash-plugin-page-builder/blocks';

export interface Props {
  value?: readonly StoredBlock[] | null;
  blocks: readonly SiteBlockType[];
  sources?: Readonly<Record<string, Source>>;
  group?: string;
  fallback?: BlockComponent<StoredBlock>;
}

const { value, blocks, sources = {}, group, fallback } = Astro.props;
const upgraded = migrateBlocks(value ?? [], blocks);
const cacheHints: import('emdash').CacheHint[] = [];
const items = new Map(await Promise.all(upgraded.map(async (block) => {
  const source = sources[block._type];
  const storedScope = block[SCOPE_FIELD_SLUG];
  const scope = storedScope === 'page' && group !== undefined ? 'page' : 'all';
  const storedCount = block[COUNT_FIELD_SLUG];
  const count = typeof storedCount === 'number' && storedCount > 0 ? storedCount : undefined;
  if (!source) return [block, []] as const;
  const result = await source({ scope, group, count });
  const read = isSourceResult(result) ? result : { items: result };
  if (read.cacheHints) cacheHints.push(...read.cacheHints);
  return [block, read.items] as const;
})));
// Sources may report the cache hints of what they read; apply them when the
// page renders with Astro's cache enabled (same pattern as EmDash's templates).
if (Astro.cache?.enabled) {
  const hint = mergeCacheHints(cacheHints);
  if (hint.tags?.length || hint.lastModified) Astro.cache.set(hint);
}
const components = Object.fromEntries(blocks.map(({ definition, sections }) => [
  definition.slug,
  createComponent((result, props, slots) => {
    const block = props.value as StoredBlock;
    const storedVariant = block[VARIANT_FIELD_SLUG];
    const variant = typeof storedVariant === 'string' ? storedVariant : 'default';
    const Section = Object.hasOwn(sections, variant) ? sections[variant] : sections.default;
    // Astro files have a props-only public type and a factory signature at runtime.
    return (Section as unknown as AstroComponentFactory)(result, { ...props, items: items.get(block) }, slots);
  }),
])) as unknown as Record<string, BlockComponent<StoredBlock>>;
---
<Blocks value={upgraded} components={components} fallback={fallback} />
