{
  "name": "emdash-plugin-page-builder",
  "version": "0.3.0",
  "description": "A page builder for EmDash: versioned block types and the Astro components that render them, on EmDash's own fields.",
  "license": "MIT",
  "author": "James Ryan (https://jamesryan.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimiryquai/emdash-plugin-page-builder.git"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.7",
    "@types/node": "24.19.2",
    "astro": "7.4.4",
    "emdash": "1.4.0",
    "mcporter": "0.17.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "bin": {
    "emdash-page-builder": "dist/cli/main.js"
  },
  "exports": {
    "./blocks": {
      "types": "./dist/blocks/index.d.ts",
      "default": "./dist/blocks/index.js"
    },
    "./blocks/PageBuilder.astro": "./src/blocks/PageBuilder.astro",
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "scripts": {
    "typecheck": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "node --test",
    "check": "npm test && npm run typecheck",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "npm run build"
  },
  "peerDependencies": {
    "astro": "^6.4.8 || ^7.2.8",
    "emdash": "^1.4.0"
  },
  "files": [
    "dist",
    "src/blocks/**/*.astro"
  ],
  "homepage": "https://github.com/jimiryquai/emdash-plugin-page-builder#readme",
  "bugs": {
    "url": "https://github.com/jimiryquai/emdash-plugin-page-builder/issues"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "page-builder",
    "astro"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
